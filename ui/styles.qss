/* Radio App Stylesheet */

* {
    background-color: #1a1a1a;
    color: #ffffff;
    font-family: 'Arial', sans-serif;
}

QMainWindow {
    background-color: #2a2a2a;
}

QWidget {
    background-color: #1a1a1a;
    border: none;
}

QPushButton {
    background-color: #0066cc;
    color: white;
    border: none;
    border-radius: 5px;
    padding: 8px 16px;
    font-weight: bold;
    font-size: 12px;
}

QPushButton:hover {
    background-color: #0052a3;
}

QPushButton:pressed {
    background-color: #003d7a;
}

#modeToggleButton {
    background-color: #ff6600;
    color: white;
    border: 2px solid #ff8833;
    border-radius: 5px;
    padding: 8px 12px;
    font-weight: bold;
    font-size: 11px;
    min-width: 60px;
}

#modeToggleButton:hover {
    background-color: #e55a00;
    border: 2px solid #ff6600;
}

#modeToggleButton:pressed {
    background-color: #cc4400;
}

QLabel {
    color: #ffffff;
}

/* Ruler Widget Styling */
RulerWidget {
    background-color: #1a1a1a;
    border-bottom: 2px solid #0066cc;
}
